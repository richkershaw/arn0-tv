{
  "name": "arn0-tv-launcher",
  "version": "0.2.0",
  "private": true,
  "description": "Minimal remote-friendly launcher for a Samsung Tizen TV",
  "scripts": {
    "preview": "node scripts/serve.mjs",
    "build": "sh scripts/build.sh",
    "devlog": "node scripts/devlog-server.mjs",
    "icon": "node scripts/make-icon.mjs",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "native:build": "sh scripts/native-build.sh",
    "native:bundle": "sh scripts/native-bundle.sh",
    "native:test": "python3 scripts/native-home/test_run.py",
    "native:inspect": "python3 scripts/native-home/run.py inspect",
    "native:query": "python3 scripts/native-home/run.py query",
    "native:verify": "python3 scripts/native-home/run.py verify",
    "native:apply": "python3 scripts/native-home/run.py apply",
    "native:restore": "python3 scripts/native-home/run.py restore"
  }
}
